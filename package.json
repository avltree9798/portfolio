{
  "name": "anthony-viriya-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run cv:generate && npm run blog:prepare && vite --host 127.0.0.1",
    "build": "npm run cv:generate && npm run blog:prepare && vue-tsc --noEmit && vite build && node scripts/generate-blog.mjs --pages",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run blog:prepare && vitest run && node --test scripts/*.test.mjs",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "check": "npm run lint && npm test && npm run build",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "test:e2e": "playwright test",
    "cv:generate": "node scripts/generate-cv.mjs",
    "blog:prepare": "node scripts/generate-blog.mjs"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/markdown-it": "^14.2.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "happy-dom": "^21.0.4",
    "markdown-it": "^15.0.3",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.1.0",
    "wrangler": "4.167.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
